---
import Phone from './Phone.astro';
import StoreButtons from './StoreButtons.astro';
import mainscreen from '../images/mainscreen.png';
import { samples, smoothPath, waterPath, distFractions } from '../lib/tide-geometry';

// Decorative 24 h tide curve (illustration, not data). Widgets reuse the same
// path so --bt-now lands on the same time of day in both places.
const pts = samples(1440, 372, 95);
const curve = smoothPath(pts);
const water = waterPath(pts, 1440, 560);
const dist = distFractions(pts);
const defaultNow = `${(dist[30] * 100).toFixed(2)}%`; // 15:00 when JS is off
---
<section class="hero dark bt-clip" id="top">
<div class="bt-hero-bg bt-par-slow" aria-hidden="true">
<svg viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
<defs><linearGradient id="bt-water-hero" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="bt-stop" style="stop-opacity:.2"></stop><stop offset="1" class="bt-stop" style="stop-opacity:0"></stop></linearGradient></defs>
<g class="bt-breathe" style="--d:1.5s"><path class="bt-rise" d={water} fill="url(#bt-water-hero)" style="--dur:1.4s;--d:.1s"></path></g>
</svg>
<svg viewBox="0 0 1440 560" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false" data-bt-dist={dist.join(',')}>
<path class="bt-draw bt-curve" pathLength="1" d={curve} style="--dur:1.6s;--d:.1s"></path>
<g class="bt-marker bt-glide" style={`offset-path:path('${curve}');offset-distance:var(--bt-now, ${defaultNow});--d:.9s;--dur:1.4s`}><circle class="bt-halo" r="18"></circle><circle class="bt-dot" r="7"></circle></g>
</svg>
</div>
<div class="wrap hero-grid bt-front">
<div class="hero-copy">
<p class="eyebrow on-dark">Bali · Tide · Swell · Wind</p>
<h1 class="h1">Know Bali's tide<br>before you go.</h1>
<p class="lead on-dark">Plan a surf, swim, reef walk, or sunset session with tide, swell, wind, and spot conditions in one beautifully simple forecast.</p>
<StoreButtons />
<div class="meta"><span>Free download</span><span>iOS · Android · Apple Watch</span><span>Metres or feet</span></div>
</div>
<div class="hero-phone bt-par-fast">
<Phone src={mainscreen} alt="Bali Tide Forecast main screen with tide chart" width="clamp(250px,30vw,380px)" eager class="bt-surface" />
</div>
</div>
<svg class="tide-line" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true"><path d="M0 78 C 180 18 300 18 480 78 C 660 138 780 138 960 78 C 1140 18 1260 18 1440 78 L1440 120 L0 120 Z" fill="rgba(72,198,240,.10)"></path><path d="M0 78 C 180 18 300 18 480 78 C 660 138 780 138 960 78 C 1140 18 1260 18 1440 78" fill="none" stroke="rgba(72,198,240,.45)" stroke-width="2"></path></svg>
</section>
