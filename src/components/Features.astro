---
import { samples, smoothPath } from '../lib/tide-geometry';

const features = [
  {
    num: '01',
    title: 'Your ocean, hour by hour',
    body: 'An interactive tide chart with the current level, tide speed, upcoming high and low tides, and the exact time for every point in the day.',
  },
  {
    num: '02',
    title: 'Find your best window',
    body: 'Choose a surf spot and see its recommended tide window, alongside wave height, period, energy, and wind conditions.',
  },
  {
    num: '03',
    title: 'Built for Bali days',
    body: 'Surfing, swimming, walking the beach, or chasing sunset — switch between Surfing and Beach profiles for a more relevant view of the ocean.',
  },
  {
    num: '04',
    title: 'Share the call',
    body: 'Send a clear tide and wave forecast image to friends before you head out.',
  },
];

// One curve along the bottom of all four cards: the tide passing through the steps.
const featCurve = smoothPath(samples(1200, 100, 70, 32));
// Underline under each title (decorative).
const UNDERLINE = 'M1 6 C 16 0, 28 0, 40 6 S 64 12, 80 6 S 104 0, 119 6';
---
<section class="sec bt-reveal" id="features">
<div class="wrap">
<div class="sec-head">
<p class="eyebrow">Key features</p>
<h2 class="h2">Everything the ocean is doing today.</h2>
</div>
<div class="cards bt-cards">
{features.map((f, i) => (
<article class="card bt-fill" style={`--d:${i * 100}ms`}><p class="num"><span class="bt-count" data-pad style={`--to:${Number(f.num)};--d:${i * 100 + 250}ms`}>{f.num}</span></p><h3 class="h3">{f.title}</h3><svg class="bt-underline" viewBox="0 0 120 12" width="120" height="12" aria-hidden="true" focusable="false"><path class="bt-draw" pathLength="1" d={UNDERLINE} style={`--d:${i * 100 + 450}ms;--dur:.9s`}></path></svg><p class="body">{f.body}</p></article>
))}
<svg class="bt-feat-curve bt-wide-only bt-wipe" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true" focusable="false" style="--d:.2s;--dur:2.2s"><path d={featCurve} vector-effect="non-scaling-stroke"></path></svg>
</div>
</div>
</section>
