---
interface Props {
  class?: string;
  style?: string;
  /** 'on-dark' (default) suits the navy sections; 'on-light' the white ones. */
  theme?: 'on-dark' | 'on-light';
}

const { class: className = '', style, theme = 'on-dark' } = Astro.props;

const APP_STORE = 'https://apps.apple.com/id/app/bali-tide-forecast/id1525663618';
const GOOGLE_PLAY = 'https://play.google.com/store/apps/details?id=com.balitideforecast';

const primary = theme === 'on-light' ? 'btn-dark' : 'btn-light';
const secondary = theme === 'on-light' ? 'btn-outline' : 'btn-ghost';
---
<div class:list={['btns', className]} style={style}>
<a class:list={['btn', primary]} href={APP_STORE}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12"></path><path d="M6.5 12.5 12 18l5.5-5.5"></path><path d="M4 21h16"></path></svg><span><small>Download on the</small>App Store</span></a>
<a class:list={['btn', secondary]} href={GOOGLE_PLAY}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12"></path><path d="M6.5 12.5 12 18l5.5-5.5"></path><path d="M4 21h16"></path></svg><span><small>Get it on</small>Google Play</span></a>
</div>
